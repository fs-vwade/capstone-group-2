{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "echo",
			"type": "shell",
			"command": "echo Hello"
		},
		{
			"label": "Install dependencies (frontend)",
			"type": "shell",
			"group": {
				"kind": "preLaunch",
				"preLaunchTask": "install:frontend"
			},
			"command": "npm",
			"args": ["install"],
			"problemMatcher": "$npm",
			"presentation": {
				"reveal": "always"
			},
			"condition": "${folder === '${workspaceFolder}/frontend'}" // Only run for frontend directory
		},
		{
			"label": "Install dependencies (backend)",
			"type": "shell",
			"group": {
				"kind": "preLaunch",
				"preLaunchTask": "install:backend"
			},
			"command": "npm",
			"args": ["install"],
			"problemMatcher": "$npm",
			"presentation": {
				"reveal": "always"
			},
			"condition": "${folder === '${workspaceFolder}/backend'}" // Only run for backend directory
		}
	]
}
